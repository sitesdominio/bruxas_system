# Copie para .env.local (nunca versione valores reais).
# Valores públicos do projeto Supabase (Settings > API Keys). A chave publicável pode ficar no navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional, SOMENTE em Development: URL usada nos e-mails de confirmação em ambiente local.
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# NUNCA defina chaves secretas (service_role) com o prefixo NEXT_PUBLIC_.
